# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq (tool / image path)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TEMPERATURE=0.7

# Gemini (chat / flirty / dirty path) — free tier from Google AI Studio
GEMINI_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.95
GEMINI_MAX_TOKENS=1024

# Optional image enhancement
HF_TOKEN=
REPLICATE_API_TOKEN=

# Persistent storage
SANDBOX_PATH=/var/data/bot_files
MEMORY_DB_PATH=/var/data/bot_memory.db

# Telegram webhook
TELEGRAM_WEBHOOK_URL=https://telegram-bot-hnzl.onrender.com
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Runtime
PORT=8080
MAX_HISTORY_MESSAGES=20
MAX_SEND_MB=48
SERIAL_MAP_TTL_SECONDS=1800
SESSION_SUMMARY_EVERY=8
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO

# Cloudflare MCP
CLOUDFLARE_MCP_ENABLED=true
CLOUDFLARE_MCP_URL=https://cloudflare-mcp.vijender935.workers.dev/mcp
CLOUDFLARE_MCP_API_KEY=
CLOUDFLARE_MCP_TIMEOUT_SECONDS=30
CLOUDFLARE_MCP_RETRIES=3

# Feature flags
MEDIA_DESCRIBE_ON_DOWNLOAD=true
MEDIA_FOLLOWUP=true
