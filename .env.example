# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_IDS=12345678

# AI
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
TEMPERATURE=0.7

# Google Drive (optional)
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}

# Optional image enhancement
HF_TOKEN=
REPLICATE_API_TOKEN=

# Persistent storage
SANDBOX_PATH=/var/data/bot_files
MEMORY_DB_PATH=/var/data/bot_memory.db

# Runtime
PORT=8080
MAX_HISTORY_MESSAGES=20
MAX_SEND_MB=48
SERIAL_MAP_TTL_SECONDS=1800
SESSION_SUMMARY_EVERY=8
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO

# Vault security
VAULT_MAX_ATTEMPTS=5
VAULT_LOCKOUT_SECONDS=900
VAULT_SESSION_SECONDS=900

# Feature flags
MEDIA_DESCRIBE_ON_DOWNLOAD=true
MEDIA_FOLLOWUP=true
SEMANTIC_EMBEDDINGS=true
