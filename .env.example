# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_IDS=12345678

# AI
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
TEMPERATURE=0.7

# Google Drive (optional; existing commands remain supported)
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}

# Remote multimodal RAG MCP
RAG_MCP_ENABLED=true
RAG_MCP_URL=https://vijender935--multimodal-rag-search-mcp-app.modal.run/mcp
RAG_MCP_API_KEY=
RAG_MCP_TIMEOUT_SECONDS=20
RAG_MCP_TOP_K=5
RAG_MCP_MODE=hybrid
RAG_MCP_RETRIES=3

# Optional image enhancement
HF_TOKEN=
REPLICATE_API_TOKEN=

# Persistent storage
SANDBOX_PATH=/var/data/bot_files
MEMORY_DB_PATH=/var/data/bot_memory.db

# Runtime
PORT=8080
MAX_HISTORY_MESSAGES=20
MAX_SEND_MB=48
SERIAL_MAP_TTL_SECONDS=1800
SESSION_SUMMARY_EVERY=8
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO

# Vault security
VAULT_MAX_ATTEMPTS=5
VAULT_LOCKOUT_SECONDS=900
VAULT_SESSION_SECONDS=900

# Feature flags
MEDIA_DESCRIBE_ON_DOWNLOAD=true
MEDIA_FOLLOWUP=true
SEMANTIC_EMBEDDINGS=true
